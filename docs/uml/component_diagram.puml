@startuml
left to right direction
skinparam componentStyle rectangle

package "Swing GUI Layer" {
  [LoginFrame / RegisterFrame]
  [DashboardFrame]
  [BuyerPanel / SellerPanel / AdminPanel]
}

package "Service / Business Logic Layer" {
  [AuthService]
  [AuctionService]
  [BidService]
  [AdminService]
}

package "DAO / Data Access Layer" {
  [UserDAO]
  [AuctionDAO]
  [BidDAO]
  [DatabaseConnection]
  [SQLite JDBC Driver]
}

database "SQLite Database File" as DB

[LoginFrame / RegisterFrame] --> [AuthService]
[LoginFrame / RegisterFrame] --> [DashboardFrame]
[DashboardFrame] --> [BuyerPanel / SellerPanel / AdminPanel]
[BuyerPanel] --> [AuctionService]
[BuyerPanel] --> [BidService]
[SellerPanel] --> [AuctionService]
[SellerPanel] --> [BidService]
[AdminPanel] --> [AdminService]
[AuthService] --> [UserDAO]
[AuctionService] --> [AuctionDAO]
[AuctionService] --> [BidDAO]
[BidService] --> [AuctionDAO]
[BidService] --> [BidDAO]
[AdminService] --> [UserDAO]
[AdminService] --> [AuctionDAO]
[AdminService] --> [BidDAO]
[UserDAO] --> [DatabaseConnection]
[AuctionDAO] --> [DatabaseConnection]
[BidDAO] --> [DatabaseConnection]
[DatabaseConnection] --> [SQLite JDBC Driver]
[SQLite JDBC Driver] --> DB
@enduml